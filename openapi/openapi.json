{
  "components": {
    "headers": {
      "RateLimitLimit": {
        "description": "Limit of the most restrictive applicable rate limit.",
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "RateLimitRemaining": {
        "description": "Requests left in the most restrictive applicable rate limit.",
        "schema": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "RateLimitReset": {
        "description": "Seconds until the rate limit window allows requests again.",
        "schema": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "RequestId": {
        "description": "UUID of the request; problem responses repeat it as request_id.",
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      },
      "RetryAfter": {
        "description": "Seconds to wait before retrying (whole seconds, at least 1).",
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "schemas": {
      "Health": {
        "properties": {
          "status": {
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Health",
        "type": "object"
      },
      "Problem": {
        "properties": {
          "code": {
            "description": "Stable machine-readable error code (UPPER_SNAKE_CASE)",
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Field-level validation problems (no input values)",
            "title": "Errors"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "UUID of the request",
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "description": "URI identifying the problem type (planned documentation URI)",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "AutoTramita REST API",
    "title": "AutoTramita API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "liveness_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal error",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          }
        },
        "summary": "Liveness: the process is running",
        "tags": [
          "health"
        ]
      }
    }
  }
}
