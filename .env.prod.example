APP_DB_OWNER_USER=autotramita_prod_owner
APP_DB_OWNER_PASSWORD=replace_with_generated_secret
APP_DB_APP_USER=autotramita_prod_app
APP_DB_APP_PASSWORD=replace_with_generated_secret
APP_DB_WORKER_USER=autotramita_prod_worker
APP_DB_WORKER_PASSWORD=replace_with_generated_secret
APP_DB_PLATFORM_USER=autotramita_prod_platform
