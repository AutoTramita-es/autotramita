{
  "realm": "autotramita-prod",
  "enabled": true,
  "displayName": "AutoTramita",
  "sslRequired": "all",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "maxDeltaTimeSeconds": 900,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 0,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 43200,
  "accessCodeLifespan": 60,
  "actionTokenGeneratedByUserLifespan": 1800,
  "actionTokenGeneratedByAdminLifespan": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "defaultSignatureAlgorithm": "RS256",
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordBlacklist(at-common-passwords.txt)",
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "REGISTER",
    "REGISTER_ERROR",
    "UPDATE_PASSWORD",
    "UPDATE_PASSWORD_ERROR",
    "UPDATE_TOTP",
    "REMOVE_TOTP",
    "UPDATE_EMAIL",
    "VERIFY_EMAIL",
    "RESET_PASSWORD",
    "RESET_PASSWORD_ERROR",
    "SEND_RESET_PASSWORD",
    "REFRESH_TOKEN_ERROR",
    "CODE_TO_TOKEN_ERROR",
    "EXECUTE_ACTIONS",
    "UPDATE_CREDENTIAL",
    "REMOVE_CREDENTIAL"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "browserFlow": "browser-loa",
  "directGrantFlow": "direct-grant-denied",
  "attributes": {
    "acr.loa.map": "{\"loa1\":1,\"loa2\":2}"
  },
  "smtpServer": {},
  "clients": [
    {
      "clientId": "at-web",
      "name": "AutoTramita web (BFF)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${AT_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://autotramita.es/api/v1/auth/callback",
        "https://admin.autotramita.es/api/v1/auth/callback",
        "https://autotramita.es/"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://autotramita.es/##https://admin.autotramita.es/",
        "backchannel.logout.url": "https://autotramita.es/api/v1/auth/oidc/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "acr.loa.map": "{\"loa1\":1,\"loa2\":2}"
      },
      "protocolMappers": [
        {
          "name": "at-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "at-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "false"
          }
        },
        {
          "name": "at-loa-times",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "loa-map",
            "claim.name": "loa_map",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "email",
        "acr",
        "basic"
      ],
      "optionalClientScopes": [],
      "fullScopeAllowed": false
    },
    {
      "clientId": "at-mobile",
      "name": "AutoTramita mobile",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://autotramita.es/app/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "acr.loa.map": "{\"loa1\":1,\"loa2\":2}",
        "backchannel.logout.url": "https://autotramita.es/api/v1/auth/oidc/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "protocolMappers": [
        {
          "name": "at-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "at-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "false"
          }
        },
        {
          "name": "at-loa-times",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "loa-map",
            "claim.name": "loa_map",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "email",
        "acr",
        "basic"
      ],
      "optionalClientScopes": [],
      "fullScopeAllowed": false
    },
    {
      "clientId": "at-admin-svc",
      "name": "AutoTramita admin service account",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${AT_ADMIN_SVC_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "service-account-at-admin-svc",
      "enabled": true,
      "serviceAccountClientId": "at-admin-svc",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "view-events"
        ]
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser-loa",
      "description": "Browser flow with level-of-authentication step-up (loa1 password, loa2 password + a second factor)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "browser-loa-forms",
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "browser-loa-forms",
      "description": "Levels in the order 1, 3, 2, 4: the order decides which level each kind of credential belongs to",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "CONDITIONAL",
          "priority": 10,
          "authenticatorFlow": true,
          "userSetupAllowed": false,
          "flowAlias": "browser-loa-1"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false,
          "flowAlias": "browser-loa-3"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 30,
          "authenticatorFlow": true,
          "userSetupAllowed": false,
          "flowAlias": "browser-loa-2"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 40,
          "authenticatorFlow": true,
          "userSetupAllowed": false,
          "flowAlias": "browser-loa-4"
        }
      ]
    },
    {
