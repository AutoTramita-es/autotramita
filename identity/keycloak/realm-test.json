{
  "realm": "autotramita-test",
  "enabled": true,
  "displayName": "AutoTramita",
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "maxDeltaTimeSeconds": 900,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 0,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 43200,
  "accessCodeLifespan": 60,
  "actionTokenGeneratedByUserLifespan": 1800,
  "actionTokenGeneratedByAdminLifespan": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "defaultSignatureAlgorithm": "RS256",
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordBlacklist(at-common-passwords.txt)",
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "REGISTER",
    "REGISTER_ERROR",
    "UPDATE_PASSWORD",
    "UPDATE_PASSWORD_ERROR",
    "UPDATE_TOTP",
    "REMOVE_TOTP",
    "UPDATE_EMAIL",
    "VERIFY_EMAIL",
    "RESET_PASSWORD",
    "RESET_PASSWORD_ERROR",
    "SEND_RESET_PASSWORD",
    "REFRESH_TOKEN_ERROR",
    "CODE_TO_TOKEN_ERROR",
    "EXECUTE_ACTIONS",
    "UPDATE_CREDENTIAL",
    "REMOVE_CREDENTIAL"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "browserFlow": "browser-loa",
  "attributes": {
    "acr.loa.map": "{\"loa1\":1,\"loa2\":2}"
  },
  "smtpServer": {
    "host": "127.0.0.1",
    "port": "18025",
    "from": "keycloak@autotramita.invalid",
    "fromDisplayName": "AutoTramita test"
  },
  "clients": [
    {
      "clientId": "at-web",
      "name": "AutoTramita web (BFF)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${AT_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:18080/api/v1/auth/callback",
        "http://127.0.0.1:18080/admin/api/v1/auth/callback",
        "http://127.0.0.1:18080/"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:18080/##http://127.0.0.1:18080/admin/",
        "backchannel.logout.url": "http://127.0.0.1:18090/api/v1/auth/oidc/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "acr.loa.map": "{\"loa1\":1,\"loa2\":2}"
      },
      "protocolMappers": [
        {
          "name": "at-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "at-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "at-mobile",
      "name": "AutoTramita mobile",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:18080/app/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "acr.loa.map": "{\"loa1\":1,\"loa2\":2}"
      },
      "protocolMappers": [
        {
          "name": "at-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "at-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "at-admin-svc",
      "name": "AutoTramita admin service account",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${AT_ADMIN_SVC_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "service-account-at-admin-svc",
      "enabled": true,
      "serviceAccountClientId": "at-admin-svc",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "view-events"
        ]
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser-loa",
      "description": "Browser flow with level-of-authentication step-up (loa1 password, loa2 password + OTP)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "browser-loa-forms",
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "browser-loa-forms",
      "description": "Level subflows",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 10,
          "flowAlias": "browser-loa-1",
          "userSetupAllowed": false,
          "autheticatorFlow": true
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "browser-loa-2",
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "browser-loa-1",
      "description": "Level 1: password",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "loa1-condition",
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    },
    {
      "alias": "browser-loa-2",
      "description": "Level 2: one-time password",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "loa2-condition",
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "loa1-condition",
      "config": {
        "loa-condition-level": "1",
        "loa-store-in-user-session": "true",
        "loa-max-age": "43200"
      }
    },
    {
      "alias": "loa2-condition",
      "config": {
        "loa-condition-level": "2",
        "loa-store-in-user-session": "true",
        "loa-max-age": "600"
      }
    }
  ]
}
